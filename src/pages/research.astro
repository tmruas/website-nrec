---
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import { fetchPosts } from '~/utils/blog';

const posts = await fetchPosts();
const metadata = {
  title: 'Research & Insights — NREC',
};
---

<Layout metadata={metadata}>
  <section id="archive" class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-7xl">
    <Headline
      subtitle="Explore our complete archive of market analysis, real estate trends, and opinion articles."
    >
      Library & Reports
    </Headline>

    <div class="max-w-md mx-auto mb-12">
      <div class="relative">
        <input 
          type="text" 
          id="search-input" 
          placeholder="Search by country, topic or author..." 
          class="w-full px-4 py-3 rounded-xl border border-gray-200 dark:border-slate-700 bg-white dark:bg-slate-900 focus:ring-2 focus:ring-blue-500 outline-none transition-all"
        />
        <div class="absolute right-3 top-3 text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
      </div>
    </div>
    
    <div id="posts-container">
      {posts.length > 0 ? (
        <BlogList posts={posts} />
      ) : (
        <p class="text-center text-muted">New reports coming soon. Stay tuned!</p>
      )}
    </div>

    <p id="no-results" class="hidden text-center text-gray-500 mt-8">
      No articles found matching your search.
    </p>
  </section>

  <script is:inline>
    const searchInput = document.getElementById('search-input');
    const noResults = document.getElementById('no-results');
    
    searchInput.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase();
      // O BlogList gera elementos <li> ou <article> dentro de uma lista
      const articles = document.querySelectorAll('#posts-container li, #posts-container article');
      let found = false;

      articles.forEach(article => {
        const text = article.innerText.toLowerCase();
        if (text.includes(searchTerm)) {
          article.style.display = 'block';
          found = true;
        } else {
          article.style.display = 'none';
        }
      });

      // Mostrar mensagem se não houver resultados
      if (!found && searchTerm !== '') {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    });
  </script>
</Layout>
