---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Real Estate Consulting Services | NREC Nova SBE',
  description: 'Professional real estate solutions tailored for the market. Our services include Market Analysis, Asset Valuation, and Financial Modeling, driven by top-tier Nova SBE talent.',
};
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Our Solutions"
    title="Professional Real Estate Services"
    subtitle="We provide high-quality analytical and strategic support for the real estate industry, powered by Nova SBE's top talent."
  />

  <Features2
    title="What we offer"
    subtitle="Tailored solutions for developers, investors, and consultants."
    items={[
      {
        title: 'Strategic Consulting',
        description: 'Market analysis, feasibility studies, and strategic planning for real estate projects.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Market Research',
        description: 'Detailed reports on market trends, demographic data, and investment opportunities.',
        icon: 'tabler:search',
      },
      {
        title: 'Asset Valuation',
        description: 'Financial modeling and rigorous valuation to support real estate decision-making.',
        icon: 'tabler:building-bank',
      },
    ]}
  />

  <CallToAction
    title="Need a custom solution?"
    subtitle="Our team is ready to help you with your next real estate project."
    actions={[{ variant: 'primary', text: 'Get in Touch', href: 'mailto:services@nrec.pt' }]}
  />
</Layout>
