---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = { title: 'Our Team — NREC' };

// Estilo comum para as molduras das fotos
const photoClass = "w-32 h-32 md:w-40 md:h-40 rounded-full mx-auto bg-slate-200 mb-4 overflow-hidden border-4 border-white shadow-lg flex items-center justify-center text-slate-400 text-xs";
const memberPhotoClass = "w-24 h-24 md:w-28 md:h-28 rounded-full mx-auto bg-slate-200 mb-3 overflow-hidden border-2 border-white shadow-md flex items-center justify-center text-slate-400 text-[10px]";
---

<Layout metadata={metadata}>
  
  <HeroText
    tagline="The Faces Behind NREC"
    title="Meet Our Team"
    subtitle="27 members, 5 specialized departments, 1 goal: Connecting talent with the real estate market."
  />

  <section class="max-w-5xl mx-auto px-4 mb-20">
    <div class="relative group">
      <img 
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=2000&q=80" 
        alt="NREC Full Team" 
        class="w-full h-auto rounded-2xl shadow-2xl border-8 border-white"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent rounded-2xl"></div>
    </div>
    <p class="text-center mt-4 text-slate-500 italic font-medium">The NREC 2023/2024 Team at Nova SBE</p>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 mb-16">
    <h2 class="text-3xl font-bold text-center mb-12 text-slate-900 border-b-2 border-blue-600 w-fit mx-auto pb-2">Board of Directors</h2>
    <div class="flex flex-wrap justify-center gap-12">
      <div class="text-center w-48">
        <div class={photoClass}>Photo</div>
        <h3 class="text-lg font-bold text-slate-900">João Silva</h3>
        <p class="text-sm text-blue-600 font-bold uppercase tracking-tighter">President</p>
      </div>
      </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16 bg-slate-50 rounded-[3rem] mb-12">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">Internal Events</h2>
    
    <div class="text-center mb-12">
      <div class={photoClass}>Photo</div>
      <h3 class="text-lg font-bold">Name</h3>
      <p class="text-sm text-blue-600 font-bold uppercase">Head of Internal Events</p>
    </div>

    <div class="flex flex-wrap justify-center gap-8">
      <div class="text-center w-32">
        <div class={memberPhotoClass}>Photo</div>
        <p class="text-sm font-bold">Member Name</p>
        <p class="text-[10px] text-slate-500 uppercase">Member</p>
      </div>
      </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16 mb-12">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">External Events</h2>
    
    <div class="text-center mb-12">
      <div class={photoClass}>Photo</div>
      <h3 class="text-lg font-bold">Name</h3>
      <p class="text-sm text-blue-600 font-bold uppercase">Head of External Events</p>
    </div>

    <div class="flex flex-wrap justify-center gap-8">
      <div class="text-center w-32">
        <div class={memberPhotoClass}>Photo</div>
        <p class="text-sm font-bold">Member Name</p>
        <p class="text-[10px] text-slate-500 uppercase">Member</p>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 py-16 bg-slate-50 rounded-[3rem] mb-12 shadow-sm">
      <h2 class="text-3xl font-bold text-center mb-4 text-slate-800">Operations & Consulting</h2>
      <p class="text-center text-slate-500 mb-12">The analytical core of NREC</p>
      
      <div class="text-center mb-16">
        <div class={photoClass}>Photo</div>
        <h3 class="text-xl font-bold text-slate-900">Name</h3>
        <p class="text-sm text-blue-600 font-bold uppercase">Head of Operations</p>
      </div>
  
      <div class="grid md:grid-cols-2 gap-16">
        <div>
          <h4 class="text-center text-slate-800 font-bold mb-8 uppercase tracking-widest border-b border-gray-200 pb-2">Consultants</h4>
          <div class="flex flex-wrap justify-center gap-6">
            <div class="text-center w-28">
              <div class={memberPhotoClass}>Photo</div>
              <p class="text-xs font-bold text-slate-900 leading-tight">Name</p>
            </div>
            </div>
        </div>
  
        <div>
          <h4 class="text-center text-slate-800 font-bold mb-8 uppercase tracking-widest border-b border-gray-200 pb-2">Researchers</h4>
          <div class="flex flex-wrap justify-center gap-6">
            <div class="text-center w-28">
              <div class={memberPhotoClass}>Photo</div>
              <p class="text-xs font-bold text-slate-900 leading-tight">Name</p>
            </div>
            </div>
        </div>
      </div>
    </section>

  <section class="max-w-6xl mx-auto px-4 py-16 mb-12">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">Marketing & Comms</h2>
    <div class="text-center mb-12">
      <div class={photoClass}>Photo</div>
      <h3 class="text-lg font-bold">Name</h3>
      <p class="text-sm text-blue-600 font-bold uppercase">Head of Marketing</p>
    </div>
    <div class="flex flex-wrap justify-center gap-8">
       </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16 bg-slate-50 rounded-[3rem] mb-20">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">Human Resources</h2>
    <div class="text-center mb-12">
      <div class={photoClass}>Photo</div>
      <h3 class="text-lg font-bold">Name</h3>
      <p class="text-sm text-blue-600 font-bold uppercase">Head of HR</p>
    </div>
    <div class="flex flex-wrap justify-center gap-8">
       </div>
  </section>

</Layout>
