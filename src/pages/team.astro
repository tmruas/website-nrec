---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = { title: 'Our Team — NREC' };
---

<Layout metadata={metadata}>
  
  <HeroText
    tagline="The Faces Behind NREC"
    title="Meet Our Team"
    subtitle="27 members, 5 specialized departments, 1 goal: Connecting talent with the real estate market."
  />

  <section class="max-w-6xl mx-auto px-4 py-12">
    <h2 class="text-3xl font-bold text-center mb-10 text-slate-900 border-b pb-4">Board of Directors</h2>
    <div class="flex flex-wrap justify-center gap-10">
      
      <div class="text-center w-48">
        <div class="w-40 h-40 rounded-full mx-auto bg-slate-200 mb-4 overflow-hidden border-4 border-white shadow-lg flex items-center justify-center text-slate-400">Photo</div>
        <h3 class="text-lg font-bold text-slate-900">Name</h3>
        <p class="text-sm text-blue-600 font-semibold">President</p>
      </div>

    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 bg-slate-50 rounded-3xl mb-8">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">External Events</h2>
    <div class="flex flex-wrap justify-center gap-8 text-center">
      
      <div class="w-32">
        <div class="w-24 h-24 rounded-full mx-auto bg-slate-200 mb-2 shadow-sm flex items-center justify-center text-slate-400 text-xs">Photo</div>
        <p class="text-sm font-bold text-slate-900">Name</p>
        <p class="text-xs text-blue-600 font-semibold mb-1">Head of Dept</p>
      </div>

      <div class="w-32">
        <div class="w-24 h-24 rounded-full mx-auto bg-slate-200 mb-2 shadow-sm flex items-center justify-center text-slate-400 text-xs">Photo</div>
        <p class="text-sm font-bold text-slate-900">Name</p>
        <p class="text-xs text-slate-500 font-medium">Member</p>
      </div>

    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 mb-8">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">Internal Events</h2>
    <div class="flex flex-wrap justify-center gap-8 text-center">
      
      <div class="w-32">
        <div class="w-24 h-24 rounded-full mx-auto bg-slate-200 mb-2 shadow-sm flex items-center justify-center text-slate-400 text-xs">Photo</div>
        <p class="text-sm font-bold text-slate-900">Name</p>
        <p class="text-xs text-blue-600 font-semibold mb-1">Head of Dept</p>
      </div>

    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 bg-slate-50 rounded-3xl mb-8">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">Operations & Consulting</h2>
    <div class="flex flex-wrap justify-center gap-8 text-center">
      
      <div class="w-32">
        <div class="w-24 h-24 rounded-full mx-auto bg-slate-200 mb-2 shadow-sm flex items-center justify-center text-slate-400 text-xs">Photo</div>
        <p class="text-sm font-bold text-slate-900">Name</p>
        <p class="text-xs text-blue-600 font-semibold mb-1">Head of Dept</p>
      </div>

    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 mb-8">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">Marketing & Comms</h2>
    <div class="flex flex-wrap justify-center gap-8 text-center">
      
      <div class="w-32">
        <div class="w-24 h-24 rounded-full mx-auto bg-slate-200 mb-2 shadow-sm flex items-center justify-center text-slate-400 text-xs">Photo</div>
        <p class="text-sm font-bold text-slate-900">Name</p>
        <p class="text-xs text-blue-600 font-semibold mb-1">Head of Dept</p>
      </div>

    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-12 bg-slate-50 rounded-3xl mb-12">
    <h2 class="text-2xl font-bold text-center mb-10 text-slate-800">Human Resources</h2>
    <div class="flex flex-wrap justify-center gap-8 text-center">
      
      <div class="w-32">
        <div class="w-24 h-24 rounded-full mx-auto bg-slate-200 mb-2 shadow-sm flex items-center justify-center text-slate-400 text-xs">Photo</div>
        <p class="text-sm font-bold text-slate-900">Name</p>
        <p class="text-xs text-blue-600 font-semibold mb-1">Head of Dept</p>
      </div>

    </div>
  </section>

</Layout>
