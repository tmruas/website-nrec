---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';

import { Image } from 'astro:assets';
import logoImg from '~/assets/images/logo.png';
// --- EDIT 1: Add this line to import your new background image ---
import bgImg from '~/assets/images/immersive-bg.jpg'; 

const metadata = {
  title: 'NREC - Nova Real Estate Club',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  {/* --- EDIT 2: Update the <Hero> tag below --- */}
  <Hero
    actions={[
      { variant: 'primary', text: 'Partnerships', href: '/parcerias' },
      { text: 'Learn More', href: '#missao' },
    ]}
    {/* --- This makes the section fill the whole screen --- */}
    class="min-h-screen flex items-center justify-center relative"
  >
    {/* --- This inserts the background image dynamically --- */}
    <Image 
      src={bgImg} 
      alt="Immersive background"
      loading="eager"
      {/* --- This styles the background to be full-screen, covers everything, and adds an overlay --- */}
      class="absolute inset-0 object-cover w-full h-full -z-10 opacity-60" 
    />

    <Fragment slot="title">
      <Image 
        src={logoImg} 
        alt="Nova Real Estate Club Logo" 
        {/* --- Centralizes and ensures text and logo are above the background --- */}
        class="mx-auto w-full max-w-xs sm:max-w-sm md:max-w-md mb-4 relative z-10" 
      />
    </Fragment>

    <Fragment slot="subtitle">
      <div class="relative z-10">
        <span class="hidden sm:inline">
          <span class="font-semibold text-black dark:text-white">Where talent meets the real estate market.</span> 
        </span>
        <br />
        <span class="text-black dark:text-white">We create learning and career bridges between Nova SBE students and the real estate industry.</span>
      </div>
    </Fragment>
  </Hero>

  </Layout>
