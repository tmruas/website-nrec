---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'AstroWind — Free template for creating websites with Astro + Tailwind CSS',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
  actions={[
    {
      variant: 'primary',
      text: 'Ver Parcerias',
      href: '/parcerias',
    },
    { text: 'Saber mais', href: '#missao' },
  ]}
  image={{
    src: '~/assets/images/hero-image.png', /* Aqui mais tarde colocamos uma foto da vossa equipa ou da NOVA! */
    alt: 'Equipa NREC',
  }}
>
  <Fragment slot="title">
    Nova Real Estate Club
  </Fragment>

  <Fragment slot="subtitle">
    <span class="hidden sm:inline">
      <span class="font-semibold">Onde o talento encontra o mercado imobiliário.</span> 
    </span>
    <br />
    [Substitui este texto pela vossa MISSÃO do slide 3: Ex: O nosso objetivo é capacitar os estudantes da NOVA com conhecimento prático e conexões de topo no setor de Real Estate.]
  </Fragment>
</Hero>

<Features2
  title="Our Mission, Values & Goals"
  subtitle="To become the go-to hub at Nova SBE for real estate knowledge and talent."
  items={[
    {
      title: 'Our Mission',
      description: 'We create learning and career bridges between Nova SBE students and the real estate industry.',
      icon: 'flat-color-icons:bullish',
    },
    {
      title: 'Our Goals',
      description: 'Offer hands-on experiences, connect with opportunities, systematize talent recruitment, and launch innovative initiatives.',
      icon: 'flat-color-icons:todo-list',
    },
    {
      title: 'What We Do',
      description: 'Consulting Services • Events • Research • Casanova',
      icon: 'flat-color-icons:briefcase',
    },
  ]}
/>

<Steps
    title="Join the Club: The Recruitment Process"
    tagline="Careers & Talent"
    isReversed={true}
    items={[
      {
        title: '01. Fill in the Forms',
        description: 'The timeline and clear criteria are well-communicated across our social media channels. Keep an eye out for our application periods!',
        icon: 'tabler:clipboard-text',
      },
      {
        title: '02. Interviews',
        description: 'Our interview scripts are tailored to each department. HR tasks are clear and structured, with templates ensuring consistent recruitment each semester.',
        icon: 'tabler:users',
      },
      {
        title: '03. Results & Feedback',
        description: 'We value transparency and every candidate\'s effort. Feedback to the candidates is always provided when asked.',
        icon: 'tabler:mail',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2084&q=80',
      alt: 'Students working together',
    }}
  />


</Layout>
