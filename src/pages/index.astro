---
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';

import { Image } from 'astro:assets';
import logoImg from '~/assets/images/logo.png';
import bgImg from '~/assets/images/immersive-bg.jpeg'; 

const metadata = {
  title: 'NREC - Nova Real Estate Club',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="flex flex-col w-full">
    
  <div class="relative w-full min-h-[80vh] md:min-h-[85vh] flex items-center justify-center overflow-hidden pt-16">
        
        <Image 
          src={bgImg} 
          alt="Immersive background"
          class="absolute inset-0 object-cover object-center w-full h-full z-0" 
        />
        
        <div class="absolute inset-0 bg-white/10 z-10"></div>
        <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-white via-white/80 to-transparent z-10"></div>
        
        <Image 
          src={logoImg} 
          alt="Nova Real Estate Club Logo" 
          class="relative w-full max-w-xs sm:max-w-sm md:max-w-md px-4 z-20 mb-10 md:mb-16" 
        />
      </div>

    <div class="w-full bg-white text-center pt-8 pb-16 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
          Where talent meets the real estate market.
        </p>
        <p class="text-base md:text-lg text-slate-800 font-medium mb-8">
          We create learning and career bridges between Nova SBE students and the real estate industry.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/parcerias" class="btn btn-primary w-full sm:w-auto shadow-md">Partnerships</a>
          <a href="#missao" class="btn w-full sm:w-auto bg-white hover:bg-gray-50 text-slate-900 shadow-sm border border-gray-200">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <Features2
    id="missao"
    title="Our Mission, Values & Goals"
    subtitle="To become the go-to hub at Nova SBE for real estate knowledge and talent."
    items={[
      { title: 'Our Mission', description: 'We create learning and career bridges between Nova SBE students and the real estate industry.', icon: 'tabler:trending-up' },
      { title: 'Our Goals', description: 'Offer hands-on experiences, connect with opportunities, systematize talent recruitment, and launch innovative initiatives.', icon: 'tabler:list-check' },
      { title: 'What We Do', description: 'Consulting Services • Events • Research • Casanova', icon: 'tabler:briefcase' }
    ]}
  />


  <Features
      id="structure"
      tagline="Our Team"
      title="Internal Structure"
      subtitle="Led by our President and Heads, the club is powered by 32 dedicated members across specialized departments."
      items={[
        { title: 'Operations & Consulting', description: 'Focuses on real estate market analysis, feasibility studies, asset management and strategic consulting projects.', icon: 'tabler:chart-bar' },
        { title: 'External Events', description: 'Responsible for the corporate partnerships and major networking sessions with industry partners.', icon: 'tabler:world' },
        { title: 'Internal Events', description: 'Coordinates workshops, technical training, and team-building for our members.', icon: 'tabler:home-heart' },
        { title: 'Marketing & Comms', description: 'Manages our brand presence, digital outreach, and communication strategy.', icon: 'tabler:speakerphone' },
        { title: 'Human Resources', description: 'Dedicated to talent recruitment, member growth, and club culture.', icon: 'tabler:users' }
      ]}
    />
  <style is:global>
      /* 1. Faz o menu flutuar em cima da imagem */
      #header {
        position: absolute !important;
        width: 100%;
      }
      
      /* 2. Remove o fundo branco inicial */
      #header:not(.is-scrolled) > div.absolute.inset-0 {
        opacity: 0 !important;
      }
      
      /* 3. Quando faz scroll, fixa o menu no topo da janela */
      #header.is-scrolled {
        position: fixed !important;
      }
      
      /* 4. Traz o fundo branco de volta suavemente durante o scroll */
      #header.is-scrolled > div.absolute.inset-0 {
        opacity: 1 !important;
        transition: opacity 0.3s ease-in-out;
    }
  </style>
</Layout>
