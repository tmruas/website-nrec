---
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';

import { Image } from 'astro:assets';
import logoImg from '~/assets/images/logo.png';
import bgImg from '~/assets/images/immersive-bg.jpeg'; 

const metadata = {
  title: 'NREC - Nova Real Estate Club',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="flex flex-col w-full">
    
  <div class="relative w-full min-h-[65vh] md:min-h-[75vh] flex items-center justify-center overflow-hidden pt-16">
        
        <Image 
          src={bgImg} 
          alt="Immersive background"
          class="absolute inset-0 object-cover object-center w-full h-full z-0" 
        />
        
        <div class="absolute inset-0 bg-white/10 z-10"></div>
        <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-white to-transparent z-10"></div>
        
        <Image 
          src={logoImg} 
          alt="Nova Real Estate Club Logo" 
          class="relative w-full max-w-xs sm:max-w-sm md:max-w-md px-4 z-20" 
        />
    </div>

    <div class="w-full bg-white text-center pt-8 pb-16 px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-xl md:text-2xl font-bold text-slate-900 mb-2">
          Where talent meets the real estate market.
        </p>
        <p class="text-base md:text-lg text-slate-800 font-medium mb-8">
          We create learning and career bridges between Nova SBE students and the real estate industry.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="/parcerias" class="btn btn-primary w-full sm:w-auto shadow-md">Partnerships</a>
          <a href="#missao" class="btn w-full sm:w-auto bg-white hover:bg-gray-50 text-slate-900 shadow-sm border border-gray-200">Learn More</a>
        </div>
      </div>
    </div>
  </section>

  <Features2
    id="missao"
    title="Our Mission, Values & Goals"
    subtitle="To become the go-to hub at Nova SBE for real estate knowledge and talent."
    items={[
      { title: 'Our Mission', description: 'We create learning and career bridges between Nova SBE students and the real estate industry.', icon: 'tabler:trending-up' },
      { title: 'Our Goals', description: 'Offer hands-on experiences, connect with opportunities, systematize talent recruitment, and launch innovative initiatives.', icon: 'tabler:list-check' },
      { title: 'What We Do', description: 'Consulting Services • Events • Research • Casanova', icon: 'tabler:briefcase' }
    ]}
  />

  <Features2
    id="servicos"
    title="Our Services"
    subtitle="Premium solutions developed by Nova SBE talent to support partners and clients."
    items={[
      { title: 'Strategic Consulting', description: 'Market analysis, feasibility studies, and strategic planning for real estate projects.', icon: 'tabler:chart-bar' },
      { title: 'Market Research', description: 'Detailed reports on market trends, demographic data, and investment opportunities.', icon: 'tabler:search' },
      { title: 'Asset Valuation', description: 'Financial modeling and rigorous valuation to support real estate decision-making.', icon: 'tabler:building-bank' }
    ]}
  />

  <Features
    id="eventos"
    title="Events & Initiatives"
    tagline="Club Agenda"
    subtitle="Keep track of all the lectures, workshops, and networking sessions organized by NREC."
    items={[
      { title: 'NREC Summit', description: 'Our flagship annual event, bringing together key real estate players and Nova SBE students.', icon: 'tabler:calendar-star' },
      { title: 'Practical Workshops', description: 'Regular sessions focused on financial modeling, real estate valuation, and soft skills.', icon: 'tabler:chalkboard' },
      { title: 'Networking Sessions', description: 'Exclusive moments for members to interact directly with top industry professionals.', icon: 'tabler:users-group' }
    ]}
  />

  <Features
    id="structure"
    tagline="Our Team"
    title="Internal Structure"
    subtitle="Led by our President and Heads, the club is powered by a total of 27 dedicated members across four key departments."
    items={[
      { title: 'Events & Partnerships', description: '3 Members focused on building synergies, networking, and organizing impactful real estate events.', icon: 'tabler:calendar-event' },
      { title: 'Operations', description: '15 Members ensuring the smooth execution of our initiatives, internal organization, and club management.', icon: 'tabler:settings' },
      { title: 'Marketing', description: '3 Members managing our brand presence, communication, and digital outreach to the Nova SBE community.', icon: 'tabler:speakerphone' },
      { title: 'Human Resources', description: '2 Members dedicated to talent recruitment, member growth, and internal feedback.', icon: 'tabler:users' }
    ]}
  />

  <Steps
    id="recrutamento"
    title="Join the Club: The Recruitment Process"
    tagline="Careers & Talent"
    isReversed={true}
    items={[
      { title: '01. Fill in the Forms', description: 'The timeline and clear criteria are well-communicated across our social media channels. Keep an eye out for our application periods!', icon: 'tabler:clipboard-text' },
      { title: '02. Interviews', description: 'Our interview scripts are tailored to each department. HR tasks are clear and structured, with templates ensuring consistent recruitment each semester.', icon: 'tabler:users' },
      { title: '03. Results & Feedback', description: 'We value transparency and every candidate\'s effort. Feedback to the candidates is always provided when asked.', icon: 'tabler:mail' }
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2084&q=80',
      alt: 'Students working together',
    }}
  />
</Layout>
