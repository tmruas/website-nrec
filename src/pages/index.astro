---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';

import { Image } from 'astro:assets';
import logoImg from '~/assets/images/logo.png';

const metadata = {
  title: 'NREC - Nova Real Estate Club',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Ver Parcerias',
        href: '/parcerias',
      },
      { text: 'Saber mais', href: '#missao' },
    ]}
  >
    <Fragment slot="title">
      <Image src={logoImg} alt="Nova Real Estate Club Logo" class="mx-auto w-full max-w-xs sm:max-w-sm md:max-w-md mb-4" />
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Where talent meets the real estate market.</span> 
      </span>
      <br />
      We create learning and career bridges between Nova SBE students and the real estate industry.
    </Fragment>
  </Hero>

  <Features2
    id="missao"
    title="Our Mission, Values & Goals"
    subtitle="To become the go-to hub at Nova SBE for real estate knowledge and talent."
    items={[
      {
        title: 'Our Mission',
        description: 'We create learning and career bridges between Nova SBE students and the real estate industry.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Our Goals',
        description: 'Offer hands-on experiences, connect with opportunities, systematize talent recruitment, and launch innovative initiatives.',
        icon: 'tabler:list-check',
      },
      {
        title: 'What We Do',
        description: 'Consulting Services • Events • Research • Casanova',
        icon: 'tabler:briefcase',
      },
    ]}
  />

  <Features2
    id="servicos"
    title="Os Nossos Serviços"
    subtitle="Soluções de excelência desenvolvidas pelo talento da Nova SBE para apoiar parceiros e clientes."
    items={[
      {
        title: 'Consultoria Estratégica',
        description: 'Análise de mercado, estudos de viabilidade e planeamento estratégico para projetos imobiliários.',
        icon: 'tabler:chart-bar',
      },
      {
        title: 'Market Research',
        description: 'Relatórios detalhados sobre tendências, dados demográficos e oportunidades de investimento.',
        icon: 'tabler:search',
      },
      {
        title: 'Avaliação de Ativos',
        description: 'Modelização financeira e avaliação rigorosa para apoiar a tomada de decisão em real estate.',
        icon: 'tabler:building-bank',
      },
    ]}
  />

  <Features
    id="eventos"
    title="Eventos & Dinâmicas"
    tagline="Agenda do Clube"
    subtitle="Fica a par de todas as palestras, workshops e sessões de networking organizadas pelo NREC."
    items={[
      {
        title: 'NREC Summit',
        description: 'O nosso evento anual de referência, reunindo os principais players do mercado imobiliário e estudantes da Nova SBE.',
        icon: 'tabler:calendar-star',
      },
      {
        title: 'Workshops Práticos',
        description: 'Sessões regulares focadas em modelização financeira, avaliação de imóveis e soft skills.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Networking Sessions',
        description: 'Momentos exclusivos para os membros interagirem diretamente com profissionais de topo do setor.',
        icon: 'tabler:users-group',
      },
    ]}
  />

  <Features
    id="structure"
    tagline="Our Team"
    title="Internal Structure"
    subtitle="Led by our President and Heads, the club is powered by a total of 27 dedicated members across four key departments."
    items={[
      {
        title: 'Events & Partnerships',
        description: '3 Members focused on building synergies, networking, and organizing impactful real estate events.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'Operations',
        description: '15 Members ensuring the smooth execution of our initiatives, internal organization, and club management.',
        icon: 'tabler:settings',
      },
      {
        title: 'Marketing',
        description: '3 Members managing our brand presence, communication, and digital outreach to the Nova SBE community.',
        icon: 'tabler:speakerphone',
      },
      {
        title: 'Human Resources',
        description: '2 Members dedicated to talent recruitment, member growth, and internal feedback.',
        icon: 'tabler:users',
      },
    ]}
  />

  <Steps
    id="recrutamento"
    title="Join the Club: The Recruitment Process"
    tagline="Careers & Talent"
    isReversed={true}
    items={[
      {
        title: '01. Fill in the Forms',
        description: 'The timeline and clear criteria are well-communicated across our social media channels. Keep an eye out for our application periods!',
        icon: 'tabler:clipboard-text',
      },
      {
        title: '02. Interviews',
        description: 'Our interview scripts are tailored to each department. HR tasks are clear and structured, with templates ensuring consistent recruitment each semester.',
        icon: 'tabler:users',
      },
      {
        title: '03. Results & Feedback',
        description: 'We value transparency and every candidate\'s effort. Feedback to the candidates is always provided when asked.',
        icon: 'tabler:mail',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521737604893-d14cc237f11d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2084&q=80',
      alt: 'Students working together',
    }}
  />
</Layout>
