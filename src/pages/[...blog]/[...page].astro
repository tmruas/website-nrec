---
import { BLOG_CONFIG } from '~/utils/config';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import { fetchPosts } from '~/utils/blog';

export async function getStaticPaths({ paginate }) {
  if (BLOG_CONFIG.disabled || BLOG_CONFIG.list.disabled) return [];
  return paginate(await fetchPosts(), {
    pageSize: BLOG_CONFIG.postsPerPage,
  });
}

const { page } = Astro.props;
const metadata = {
  title: `Research & Insights ${page.currentPage > 1 ? ` — Page ${page.currentPage}` : ''}`,
  robots: {
    index: BLOG_CONFIG.list.index,
    follow: BLOG_CONFIG.list.follow,
  },
  noindex: BLOG_CONFIG.list.index === false,
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="Explore our latest market analysis, real estate trends, and club updates."
    >
      Research & Insights
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
