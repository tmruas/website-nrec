---
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import { fetchPosts } from '~/utils/blog';

export async function getStaticPaths({ paginate }) {
  // Vamos buscar os posts diretamente sem depender de ficheiros de config externos
  const allPosts = await fetchPosts();
  return paginate(allPosts, {
    pageSize: 6, 
  });
}

const { page } = Astro.props;
const metadata = {
  title: `Research & Insights ${page.currentPage > 1 ? ` — Page ${page.currentPage}` : ''}`,
};
---

<Layout metadata={metadata}>
  <section class="px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="Explore our latest market analysis, real estate trends, and club updates."
    >
      Research & Insights
    </Headline>
    <BlogList posts={page.data} />
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
